# Copia questo file in .env.local (che NON va su GitHub) e incolla i valori del tuo progetto Supabase:
# Dashboard → Project Settings → API (o "API Keys")
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# La "Publishable key" (sb_publishable_…) o la vecchia "anon public": è pubblica, protetta dalle regole RLS.
# NON usare mai la "Secret key" / "service_role" qui: dà accesso a tutto.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
